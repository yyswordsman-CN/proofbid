# Gemini / Vertex AI
PROOFBID_GEMINI_MODEL=gemini-3.5-flash
PROOFBID_GEMINI_AUTH=vertex_ai
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Task service / Cloud Run
PROOFBID_STORAGE_BACKEND=local
PROOFBID_TASK_ROOT=/tmp/proofbid-tasks
PROOFBID_TASK_BUCKET=
PROOFBID_CLOUD_RUN_JOB=proofbid-agent
PROOFBID_CLOUD_RUN_LOCATION=us-central1
PROOFBID_AGENT_MODE=google
PROOFBID_DAILY_DEMO_QUOTA=40
PROOFBID_ALLOWED_FIXTURES=complete_tender
PROOFBID_BUILD_VERSION=
