{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbid.local/contracts/execution-plan.v1.schema.json",
  "title": "ProofBid ExecutionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_spec_digest", "steps", "summary"],
  "properties": {
    "schema_version": {"const": "proofbid.execution-plan/v1"},
    "task_spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "tool", "depends_on", "completion_criterion"],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "tool": {"$ref": "#/$defs/tool"},
          "depends_on": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "completion_criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 600}
  },
  "$defs": {
    "tool": {
      "enum": [
        "proofbid.scan_workspace",
        "proofbid.extract_requirements",
        "proofbid.load_bidder_profile",
        "proofbid.load_catalog",
        "proofbid.build_analysis",
        "proofbid.validate_bundle",
        "proofbid.render_bundle",
        "proofbid.validate_artifacts"
      ]
    }
  }
}
