{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbid.local/contracts/task-spec.v1.schema.json",
  "title": "ProofBid TaskSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "inputs",
    "allowed_tools",
    "required_deliverables",
    "prohibited_actions",
    "max_plan_steps"
  ],
  "properties": {
    "schema_version": {"const": "proofbid.task-spec/v1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "goal": {"type": "string", "minLength": 1, "maxLength": 800},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "document_type", "source_hash", "size_bytes"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "document_type": {
            "enum": ["markdown", "text", "json", "csv"]
          },
          "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "proofbid.scan_workspace"},
        {"const": "proofbid.extract_requirements"},
        {"const": "proofbid.load_bidder_profile"},
        {"const": "proofbid.load_catalog"},
        {"const": "proofbid.build_analysis"},
        {"const": "proofbid.validate_bundle"},
        {"const": "proofbid.render_bundle"},
        {"const": "proofbid.validate_artifacts"}
      ],
      "items": false
    },
    "required_deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "max_plan_steps": {"const": 8}
  },
  "$defs": {
    "tool": {
      "enum": [
        "proofbid.scan_workspace",
        "proofbid.extract_requirements",
        "proofbid.load_bidder_profile",
        "proofbid.load_catalog",
        "proofbid.build_analysis",
        "proofbid.validate_bundle",
        "proofbid.render_bundle",
        "proofbid.validate_artifacts"
      ]
    }
  }
}
