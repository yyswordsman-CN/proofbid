{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbid.local/contracts/provider-receipt.v1.schema.json",
  "title": "ProofBid ProviderReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "configured_model",
    "model_version",
    "auth_mode",
    "adk_version",
    "genai_version",
    "started_at",
    "duration_ms",
    "event_count",
    "invocation_id",
    "interaction_id",
    "finish_reason",
    "prompt_tokens",
    "output_tokens",
    "total_tokens",
    "request_digest",
    "response_digest",
    "plan_digest",
    "schema_validated",
    "policy_validated"
  ],
  "properties": {
    "schema_version": {"const": "proofbid.provider-receipt/v1"},
    "provider": {"type": "string", "minLength": 1},
    "configured_model": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 300},
    "auth_mode": {"enum": ["api_key", "vertex_ai", "test"]},
    "adk_version": {"type": "string", "minLength": 1},
    "genai_version": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 1},
    "invocation_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "interaction_id": {"type": ["string", "null"]},
    "finish_reason": {"const": "STOP"},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_validated": {"const": true},
    "policy_validated": {"const": true}
  }
}
